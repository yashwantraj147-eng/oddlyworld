{
  "name": "oddlyworld",
  "productName": "ODDLYWORLD: The Infinite Toybox",
  "version": "1.0.0",
  "description": "A whimsical, endlessly explorable digital desktop toybox where you invent creatures, build absurd machines, and alter the laws of miniature universes.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs --dev\"",
    "electron:start": "electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win dir",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.oddlyworld.toybox",
    "productName": "ODDLYWORLD",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
